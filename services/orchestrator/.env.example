# Copy to .env (in this directory) and edit. Every var is prefixed
# LAKEBRIDGE_ — Settings reads them via pydantic-settings.

LAKEBRIDGE_ENV=dev
LAKEBRIDGE_REGION=local
LAKEBRIDGE_BUILD=dev

# SQL Server — the application metadata AND staging lake live here.
LAKEBRIDGE_MSSQL_HOST=localhost
LAKEBRIDGE_MSSQL_PORT=1433
LAKEBRIDGE_MSSQL_DATABASE=lakebridge
LAKEBRIDGE_MSSQL_USER=sa
LAKEBRIDGE_MSSQL_PASSWORD=Lakebridge!Dev2026
LAKEBRIDGE_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
LAKEBRIDGE_MSSQL_ENCRYPT=yes
LAKEBRIDGE_MSSQL_TRUST_SERVER_CERTIFICATE=yes
LAKEBRIDGE_MSSQL_POOL_SIZE=8

# Scheduler / runner
LAKEBRIDGE_SCHEDULER_ENABLED=true
LAKEBRIDGE_SCHEDULER_TICK_SEC=5
LAKEBRIDGE_RUNNER_CONCURRENCY=4

# API
LAKEBRIDGE_API_HOST=0.0.0.0
LAKEBRIDGE_API_PORT=8080
LAKEBRIDGE_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Authentication
# auth_mode:
#   oidc     — Okta SSO; requires the OIDC vars below
#   dev      — POST /api/auth/dev-session signs you in as a seeded user
#   disabled — every request is anonymous Admin (tests / CI only)
LAKEBRIDGE_AUTH_MODE=dev
# CHANGE THIS in any non-local environment. Rotating invalidates all sessions.
LAKEBRIDGE_SESSION_SECRET=change-me-in-production
LAKEBRIDGE_SESSION_COOKIE_NAME=lb_session
LAKEBRIDGE_SESSION_MAX_AGE_SEC=28800

# OIDC (only consulted when LAKEBRIDGE_AUTH_MODE=oidc)
# LAKEBRIDGE_OIDC_ISSUER=https://corp.okta.com/oauth2/default
# LAKEBRIDGE_OIDC_CLIENT_ID=
# LAKEBRIDGE_OIDC_CLIENT_SECRET=
# LAKEBRIDGE_OIDC_AUDIENCE=               # defaults to client_id
# LAKEBRIDGE_OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
# LAKEBRIDGE_OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/

# Oracle source credentials.
# Each source row's `secret_ref` (e.g. `secret/lakebridge/ifs-reader`) is
# translated to env var `LAKEBRIDGE_SECRET_SECRET_LAKEBRIDGE_IFS_READER`.
# In production wire these to Vault / Azure Key Vault / AWS Secrets Manager.
LAKEBRIDGE_SECRET_SECRET_LAKEBRIDGE_IFS_READER=replace-me
LAKEBRIDGE_SECRET_SECRET_LAKEBRIDGE_IFS_READER_US=replace-me
LAKEBRIDGE_SECRET_SECRET_LAKEBRIDGE_IFS_READER_TST=replace-me
